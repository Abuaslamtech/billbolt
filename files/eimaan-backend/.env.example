# Railway/Render/Fly will provide DATABASE_URL automatically if you add
# their managed Postgres add-on. For local dev, point this at your own
# Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/eimaan"

# Any long random string — this is what the Expo app sends as x-api-key.
API_KEY="change-me-to-something-long-and-random"

PORT=3000
