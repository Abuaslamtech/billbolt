{
  "expo": {
    "name": "billbolt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "billbolt",
    "slug": "billbolt",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.billbolt.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Billbolt needs camera access to scan product barcodes and QR labels.",
        "NSFaceIDUsageDescription": "Billbolt uses Face ID to securely unlock your store register.",
        "UIRequiresFullScreen": true
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0052CC"
      },
      "package": "com.billbolt.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "Billbolt needs camera access to scan product barcodes and QR labels."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Billbolt uses Face ID to securely unlock your store register."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Billbolt needs access to your photos to upload store logos and product images."
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "googleClientId": "381178769112-s39q38b0r1hkuvg974li9fnnp5b2lir2.apps.googleusercontent.com",
      "eas": {
        "projectId": "162d906f-8461-4291-b4e6-0fa5e12ff66c"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/162d906f-8461-4291-b4e6-0fa5e12ff66c"
    },
    "owner": "abuaslam"
  }
}